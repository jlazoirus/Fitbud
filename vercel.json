{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/beta",
      "destination": "/beta-reclutamiento.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 8 * * *"
    }
  ]
}
