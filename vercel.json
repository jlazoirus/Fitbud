{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/whatsapp",
      "destination": "/api/push-subscribe?channel=whatsapp"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/admin",
      "destination": "/app/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/beta",
      "destination": "/beta-reclutamiento.html"
    },
    {
      "source": "/planes",
      "destination": "/planes/index.html"
    },
    {
      "source": "/pago",
      "destination": "/pago/index.html"
    },
    {
      "source": "/registro",
      "destination": "/registro/index.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos/index.html"
    },
    {
      "source": "/devoluciones",
      "destination": "/devoluciones/index.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad/index.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto/index.html"
    },
    {
      "source": "/libro-de-reclamaciones",
      "destination": "/libro-de-reclamaciones/index.html"
    },
    {
      "source": "/cuenta",
      "destination": "/cuenta/index.html"
    },
    {
      "source": "/unete",
      "destination": "/unete/index.html"
    },
    {
      "source": "/api/unete",
      "destination": "/api/beta-recruitment?op=unete"
    },
    {
      "source": "/api/culqi-charge",
      "destination": "/api/checkout?op=culqi"
    },
    {
      "source": "/api/reclamaciones",
      "destination": "/api/checkout?op=reclamaciones"
    },
    {
      "source": "/api/suscripcion/estado",
      "destination": "/api/checkout?op=suscripcion-estado"
    },
    {
      "source": "/api/suscripcion/cancelar",
      "destination": "/api/checkout?op=suscripcion-cancelar"
    },
    {
      "source": "/api/suscripcion",
      "destination": "/api/checkout?op=suscripcion"
    },
    {
      "source": "/api/culqi-webhook",
      "destination": "/api/checkout?op=culqi-webhook"
    }
  ],
  "functions": {
    "api/notify.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 8 * * *"
    }
  ]
}
