# El proyecto público @jlazo/evolv ya está fijado en app.config.ts (NAT-29).
# No hace falta un .env para arrancar o exportar la app.
# Solo para usar un proyecto aislado de QA, sobrescribir ambos valores:
# EAS_PROJECT_ID=11111111-1111-4111-8111-111111111111
# EXPO_OWNER=evolv-qa

# Identificadores provisionales: sustituir cuando NAT-H2 los confirme.
# IOS_BUNDLE_IDENTIFIER=club.evolvapp.app
# ANDROID_PACKAGE_NAME=club.evolvapp.app

# Nunca guardar contraseñas, EXPO_TOKEN, certificados o llaves aquí ni en Git.
